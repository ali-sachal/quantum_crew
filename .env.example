# ============================================================
# FoodMatch Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# ============================================================

# --- Server Configuration ---
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Google Gemma 4 via Gemini API SDK (google-genai) ---
# DO NOT GUESS OR HARDCODE GEMMA_MODEL_ID.
# Get your API key and exact Gemma model ID from Google AI Studio (e.g. https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL_ID=your_gemma_4_model_id_from_ai_studio

# --- Snowflake & CoCo Configuration ---
# Marketplace dataset for food desert deficit prediction
SNOWFLAKE_ACCOUNT=your_snowflake_account_id
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=FOODMATCH_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# --- Solana Devnet & Agent Registry Configuration ---
# Isolate behind Solana adapter module; do not hardcode addresses
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=your_base58_devnet_private_key
SOLANA_REGISTRY_PROGRAM_ID=your_solana_agent_registry_program_id

# --- Matchmaker Algorithm Tuning ---
# Weights must sum to 1.0 (Deficit vs Geographic Distance)
MATCH_WEIGHT_DEFICIT=0.6
MATCH_WEIGHT_DISTANCE=0.4

# --- Database ---
DATABASE_URL=sqlite:///./foodmatch.db

# --- Frontend API Endpoint ---
VITE_API_URL=http://localhost:8000/api
